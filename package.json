{
  "name": "base-pattern-desk",
  "version": "1.0.0",
  "private": true,
  "description": "O'Neil-style base pattern charting, market direction, screener and portfolio risk review for iPhone, iPad and Mac.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "desktop": "vite build && electron .",
    "dist:mac": "vite build && electron-builder --mac zip --arm64 --x64",
    "dist:win": "vite build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "8.0.1",
    "lightweight-charts": "5.2.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "vite": "8.3.5"
  },
  "main": "desktop/main.cjs",
  "author": "Base Pattern Desk",
  "build": {
    "appId": "app.basepatterndesk.desktop",
    "productName": "Base Pattern Desk",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "asar": true,
    "mac": {
      "category": "public.app-category.finance",
      "icon": "resources/icon-1024.png",
      "identity": null,
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon-1024.png",
      "target": [
        "zip"
      ]
    },
    "artifactName": "Base-Pattern-Desk-${version}-${os}-${arch}.${ext}"
  }
}
